# jshookmcp runtime overrides
#
# Copy to `.env` only when you need to override built-in defaults.
# If a key is omitted, runtime falls back to the defaults in the config/constants layer.

# ── Browser / Puppeteer ────────────────────────────────────────────────
PUPPETEER_EXECUTABLE_PATH=
CHROME_PATH=
BROWSER_EXECUTABLE_PATH=
# PUPPETEER_HEADLESS=false
# PUPPETEER_TIMEOUT=30000
# BROWSER_IDLE_TIMEOUT_MS=300000

# ── Runtime paths (customize only if you want non-default locations) ──
MCP_PROJECT_ROOT=
MCP_SCREENSHOT_DIR=screenshots
CAPTCHA_SCREENSHOT_DIR=screenshots/captcha
MCP_DEBUGGER_SESSIONS_DIR=debugger-sessions
MCP_EXTENSION_REGISTRY_DIR=artifacts/extension-registry
MCP_TLS_KEYLOG_DIR=artifacts/tmp
MCP_REGISTRY_CACHE_DIR=.jshookmcp/cache

# ── Transport / auth ───────────────────────────────────────────────────
# MCP_TRANSPORT=stdio
# MCP_SERVER_NAME=jshookmcp
# MCP_SERVER_VERSION=
# MCP_TOOL_PROFILE=search
# MCP_TOOL_DOMAINS=
# MCP_HOST=127.0.0.1
# MCP_PORT=3000
# MCP_ALLOW_INSECURE=false
# MCP_HEALTH_VERBOSE=false
# MCP_HTTP_REQUEST_TIMEOUT_MS=30000
# MCP_HTTP_HEADERS_TIMEOUT_MS=10000
# MCP_HTTP_KEEPALIVE_TIMEOUT_MS=86400000
# MCP_HTTP_FORCE_CLOSE_TIMEOUT_MS=5000
# MCP_MAX_BODY_BYTES=10485760
# MCP_RATE_LIMIT_ENABLED=true
# MCP_RATE_LIMIT_WINDOW_MS=60000
# MCP_RATE_LIMIT_MAX=60
# MCP_TRUST_PROXY=false
# MCP_HTTP_MAX_INFLIGHT=64
# MCP_HTTP_MAX_SSE_INFLIGHT=8
# MCP_BROWSER_SESSION_QUEUE_MAX_PENDING=256
# MCP_BROWSER_SESSION_QUEUE_MAX_PENDING_PER_SESSION=16
# MCP_BROWSER_SESSION_QUEUE_WAIT_TIMEOUT_MS=180000
# MCP_BROWSER_SESSION_SCHEDULER_QUANTUM_MS=250
# MCP_BROWSER_SESSION_SCHEDULER_AGING_MS=15000
# MCP_BROWSER_SESSION_EXPECTED_CONCURRENCY=10
# MCP_BROWSER_SESSION_RESERVED_PENDING_PER_SESSION=1
# MCP_BROWSER_SESSION_COST_EWMA_ALPHA=0.2
# MCP_BROWSER_FLEET_WORKER_ID=local
# MCP_BROWSER_FLEET_WORKERS_JSON=[{"id":"local"}]
# MCP_BROWSER_FLEET_VIRTUAL_NODES=128
# MCP_BROWSER_FLEET_LEASE_TTL_MS=600000
# MCP_BROWSER_FLEET_MAX_LOCAL_LEASES=4096
MCP_AUTH_TOKEN=
# JSHOOK_INSTANCE_WARN_AT=2
# JSHOOK_MAX_INSTANCES=0

# ── MCP structured logging (opt-in) ───────────────────────────────────
# LOG_LEVEL=info
# MCP_LOG_ENABLED=false
# MCP_LOG_LEVEL=info
# MCP_LOG_FILE_DIR=

# ── MRTR requestState (ElicitationBridge suspend/resume) ──────────────
# Secret for encrypted MRTR requestState tokens (>= 16 chars, multi-instance only)
MCP_REQUEST_STATE_SECRET=

# ── JIT argument validation (registry fast path) ──────────────────────
# Level-2 fast argument validation before tool dispatch (set to false to disable)
# MCP_FAST_VALIDATION=true

# ── Extension / workflow discovery ─────────────────────────────────────
EXTENSION_REGISTRY_BASE_URL=
# Public registry URL: https://raw.githubusercontent.com/vmoranv/jshookmcpextension/master/registry
MCP_PLUGIN_ROOTS=
MCP_WORKFLOW_ROOTS=
MCP_PLUGIN_ALLOWED_DIGESTS=
# MCP_PLUGIN_SIGNATURE_REQUIRED=false
# MCP_PLUGIN_STRICT_LOAD=false

# ── External bridges / services ────────────────────────────────────────
CAPTCHA_PROVIDER=manual
CAPTCHA_API_KEY=
CAPTCHA_SOLVER_BASE_URL=
CAPTCHA_2CAPTCHA_BASE_URL=
CAPTCHA_ANTICAPTCHA_BASE_URL=
CAPTCHA_CAPSOLVER_BASE_URL=
BURP_MCP_SSE_URL=http://127.0.0.1:9876
GHIDRA_BRIDGE_URL=http://127.0.0.1:18080
IDA_BRIDGE_URL=http://127.0.0.1:18081

# ── Optional performance / cache overrides ─────────────────────────────
# ENABLE_CACHE=false
# CACHE_DIR=.cache
# CACHE_TTL=3600
# JSHOOK_IO_CONCURRENCY=4
# JSHOOK_CPU_CONCURRENCY=2
# JSHOOK_CDP_CONCURRENCY=2
# MAX_CONCURRENT_ANALYSIS=3
# MAX_CODE_SIZE_MB=10
# OFFLOADER_DETAIL_THRESHOLD=524288
# OFFLOADER_FILE_THRESHOLD=4194304
# OFFLOADER_OUTPUT_DIR=artifacts/offloaded
# OFFLOADER_EXCLUDE_TOOLS=

# ── Optional search overrides ──────────────────────────────────────────
# Run `npx tsx scripts/search-tune/optimize.ts` to auto-tune and apply to .env.
# Only override below if you need device-specific values different from defaults.
# SEARCH_QUERY_CATEGORY_PROFILES_JSON=
# SEARCH_CJK_QUERY_ALIASES_JSON=
# SEARCH_INTENT_TOOL_BOOST_RULES_JSON=
#
# Scoring (defaults are auto-tuned — override only for device-specific tuning):
# SEARCH_TRIGRAM_WEIGHT=0.02
# SEARCH_TRIGRAM_THRESHOLD=0.47
# SEARCH_RRF_BM25_BLEND=0.39
# SEARCH_RRF_K=18
# SEARCH_RRF_RESCALE_FACTOR=2100
# SEARCH_PREFIX_MATCH_MULTIPLIER=0.84
# SEARCH_COVERAGE_PRECISION_FACTOR=0.94
# SEARCH_DOMAIN_HUB_THRESHOLD=5
# SEARCH_DOMAIN_HUB_BOOST_MULTIPLIER=1.04
# SEARCH_BM25_K1=1
# SEARCH_BM25_B=0.75
# SEARCH_EXACT_NAME_MATCH_MULTIPLIER=3.2
# SEARCH_AFFINITY_BOOST_FACTOR=0.38
# SEARCH_AFFINITY_BASE_WEIGHT=0.5
# SEARCH_AFFINITY_TOP_N=9
# SEARCH_PARAM_TOKEN_WEIGHT=1.1
# SEARCH_SYNONYM_EXPANSION_LIMIT=2
# SEARCH_SCENE_KEYWORD_WEIGHT=0.8
# SEARCH_RECENCY_MAX_BOOST=0.1
# SEARCH_TIER_PENALTY=0.35
# SEARCH_TIER_PENALTY_SEARCH=0.4
# SEARCH_TIER_PENALTY_WORKFLOW=0.6
# SEARCH_TIER_PENALTY_FULL=0.6
# SEARCH_WORKFLOW_DOMAIN_BOOST_MULTIPLIER=2.4
# SEARCH_VECTOR_BM25_SKIP_THRESHOLD=8
# SEARCH_VECTOR_COSINE_WEIGHT=0.53
# SEARCH_VECTOR_DYNAMIC_WEIGHT=true
# SEARCH_VECTOR_LEARN_UP=0.13
# SEARCH_VECTOR_LEARN_DOWN=0.02
# SEARCH_VECTOR_LEARN_TOP_N=3
# SEARCH_CACHE_VECTOR_WEIGHT_TOLERANCE=0.05
# SEARCH_RECENCY_TRACKER_MAX=200
# SEARCH_VECTOR_PREWARM=false
# SEARCH_VECTOR_ENABLED=false  # default false on stdio, true on HTTP
# SEARCH_VECTOR_MODEL_ID=minishlab/potion-code-16M-v2  # Model2Vec-compatible static model
# SEARCH_VECTOR_WORKER_IDLE_MS=15000
# SEARCH_VECTOR_FETCH_TIMEOUT_MS=15000
# SEARCH_VECTOR_RETRY_COOLDOWN_MS=60000
# SEARCH_VECTOR_CACHE_ENABLED=true
# JSHOOK_EMBEDDING_CACHE_DIR=
# JSHOOK_EMBEDDING_MODEL_CACHE_DIR=
# NETWORK_BODY_CACHE_MAX_ENTRIES=200
# NETWORK_BODY_CACHE_MAX_BODY_BYTES=1048576
# NETWORK_BODY_CACHE_MAX_TOTAL_BYTES=67108864
# RERANK_BROWSER_LAUNCH_BOOST=1.35
# RERANK_BROWSER_ATTACH_BOOST=1.55
# RERANK_MAINTENANCE_PENALTY=0.43
# RERANK_NETWORK_GET_REQUESTS_BOOST=1.55
# RERANK_NETWORK_MONITOR_BOOST=1.6
# RERANK_STATELESS_COMPUTE_BOOST=2.2
# RERANK_STATELESS_CORE_PENALTY=0.15
