# Dependencies
node_modules/

# Lock files
# Track pnpm-lock.yaml for reproducible installs; ignore other package-manager lockfiles.
package-lock.json
yarn.lock

# Build output
dist/

# NOTE: src/server/registry/generated-*.ts (generated-domains.ts,
# generated-tool-catalog.ts, generated-tool-domains.ts) are produced by
# scripts/generate-domains-index.mjs but are committed on purpose — production
# code imports them, so a fresh clone must typecheck without running the
# generator first. Do not add them here.
build/
stats.html
*.tsbuildinfo
plugins/**/manifest.js

# Environment variables
.env
.env.local
.env.*.local

# Logs
logs/
*.log
npm-debug.log*
pnpm-debug.log*

# Cache directories
.cache/
.temp/
tmp/
.pnpm-store/
.tmp-*.json

# SQLite databases (exploitdb cache, etc.)
*.sqlite
*.sqlite3
*.db

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.planning/
.release-artifacts/

# OS
.DS_Store
Thumbs.db

# Test coverage & artifacts
coverage/
.nyc_output/
test-screenshots/
screenshots/

# Puppeteer browser downloads
.local-chromium/
.local-firefox/

# Session data
sessions/
*.session
.jshookmcp/

# Generated artifacts (HAR exports, screenshots, debug sessions)
# HAR files from network_export_har / web_api_capture_session auto-export
*.har
jshook-capture-*
artifacts/
/workflows/
/plugins/

# V8 --trace-turbo artifacts (turbo-<name>-<id>.json IR dumps +
# turbo-<pid>-<srcId>.cfg C1 visualizer files). TurboFanTraceCollector
# routes these into artifacts/tmp/ (covered by `artifacts/` above); this
# pattern is a safety net for accidental `node --trace-turbo` from the
# repo root.
turbo-*.json
turbo-*.cfg

# Debug artifacts
debug/
debugger-sessions/
*.debug

# Temporary test/MCP artifacts
.tmp_mcp_artifacts/
# Per-test artifact namespaces. `resolveArtifactPath({ customDir })` treats a
# relative customDir as a path under the project root, so a test that passes
# `customDir: 'evict-0'` writes real directories into the repo instead of a
# temp dir. 128 such directories (evict-0..63 / lru-0..63) had accumulated
# this way. Namespacing them here keeps a stray run from polluting git status;
# the real fix is for a test to pass an absolute path under a temp dir.
/evict-[0-9]*/
/lru-[0-9]*/

# Ad-hoc test scripts (not the main tests/ suite)
test/

# Tool-generated spec/change directories
openspec/

# apk-packer fixture binaries (regenerated by build-signing-block-fixtures.ts)
tests/fixtures/apk-packer/*.apk
tests/fixtures/apk-packer/*.zip

# AI tool local configs — tracked in repo so agents can read, but not generated content
.context/
.github/prompts/
.github/skills/

# AI-generated documentation
# 根目录和所有子目录的 CLAUDE.md 都忽略（AI 临时上下文，不提交）
CLAUDE.md
**/CLAUDE.md
DESIGN.md
**/CONTEXT.md

# Other AI/tool local configs
.augment/
.claude/
.serena/
AGENTS.md
.ccg/
# WorkBuddy agent workspace: cross-session memory + scratch. Local to this
# machine, never a deliverable. Without this entry the directory is untracked
# AND unignored, so any `git clean -fd` wipes it — which happened twice on
# 2026-10-08, taking .workbuddy-ai/memory/*.md with it.
.workbuddy-ai/

# VitePress build output
docs/.vitepress/dist/
docs/.vitepress/cache/
.ace-tool/
.mimosa/

# Codacy CLI local cache and config
.codacy/


#Ignore vscode AI rules
CONTEXT-MAP.md
docs/agents
# CodeGraph local index (codegraph CLI)
.codegraph/

# Local-only telemetry ingress deployment (wrangler config holds account-specific database_id).
# Anchored to the repo root: the bare `telemetry/` form also matched
# skills/telemetry/ (a bundled guide) and silently excluded it from git —
# CI checkouts then had only 5 of the 6 skills and the skills-extension
# test failed on Linux while passing on case-insensitive Windows.
/telemetry/
